  "thesis": [
    {
      "title": "高端五轴CNC国产替代：进口依存度仍高达70%以上",
      "desc": "中国高端五轴加工中心市场长期被DMG MORI（德）、Makino（日）、Hermle（德）主导，国产品牌在主轴精度、热变形补偿、复合加工能力上落后约一代。拓璞數控聚焦航空发动机叶片、机身框架等对精度要求最苛刻的细分场景，可寻址市场超500亿元人民币，国内优质五轴机床IPO供给极度稀缺，港股首发有望享受稀缺性溢价"
    },
    {
      "title": "航空航天客户认证壁垒形成3-5年供应商锁定效应",
      "desc": "航空关键零件加工设备须经NADCAP认证或主机厂自有质量体系审核，评估周期3-5年，通过后供应商替换成本极高（重认证+工艺重验证）。拓璞數控一旦进入航空发动机厂或飞机主机厂供应链，后续订单稳定性显著高于通用机床厂商，形成项目制收入的强预测性，有效对冲行业周期波动"
    },
    {
      "title": "新能源与半导体设备开辟第二增长极，分散航空单一风险",
      "desc": "新能源车电池托盘、电机壳体等铝合金精密件大量使用高速五轴加工中心，景气周期延伸至2027年以上；国内半导体设备厂商（北方华创、中微等）扩产带动腔体、法兰盘等高精零件加工需求急升。两大新兴下游合计有望贡献30-40%增量营收，显著降低对单一航空客户的依赖"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "核心功能部件高度依赖日德进口：断供或加税直接冲击整机成本",
      "desc": "高端五轴机床的滚珠丝杠（THK/NSK）、精密主轴轴承（FAG/SKF）、高端数控系统（Siemens/Fanuc）超过60%来自日德供应商，若地缘风险升级或出口管制扩围，整机成本将上升15-25%，且短期内国内替代品（汉江丝杠、科德自研主轴）在精度保持性与寿命一致性上仍存代差，无法快速完成100%国产化切换"
    },
    {
      "icon": "⚠️",
      "title": "项目制交付叠加大客户集中：单笔验收延迟引发营收剧烈波动",
      "desc": "航空航天项目验收依赖客户生产节奏而非拓璞數控自身控制，前五大客户若集中于2-3家航空主机厂，单客户资本开支推迟一个季度即可造成当年营收20-30%缺口。科德数控历史上曾因大客户支出节奏变动导致收入增速从40%骤降至个位数，拓璞數控面临完全相同的结构性风险，港股市场对此类业绩能见度低的工业公司估值容忍度极低"
    }
  ],
