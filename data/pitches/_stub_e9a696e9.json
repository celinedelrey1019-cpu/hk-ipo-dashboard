  "thesis": [
    {
      "title": "全球唯一商业化气体发酵乙醇工厂，零成本原料构建护城河",
      "desc": "首鋼朗澤Caofeidian工厂是全球首个、也是目前唯一商业规模运营的工业废气气体发酵制乙醇项目（2018年投产），以首钢京唐钢厂高炉煤气（CO、CO₂、H₂混合气）为底物，通过LanzaTech专利菌株（自产乙醇梭菌）发酵生产燃料级乙醇。原料来自钢厂必须处理的废气，实质采购成本为零，与玉米基乙醇（原料占成本约55-65%）对比具有结构性毛利优势，技术壁垒高、复制成本巨大，短期内国内无同类竞争者。"
    },
    {
      "title": "E10强制掺混+CCER碳信用，政策双轮驱动收入确定性强",
      "desc": "中国持续推进E10乙醇汽油（成品汽油中强制掺混10%燃料乙醇）全国铺开，国家能源局等多部门支持非粮第二代生物乙醇优先配额，首鋼朗澤产品处于政策优先保障供给序列。同时，工业废气基生物乙醇每吨可产生约1.5-2吨CO₂当量减排量，可申请CCER碳信用。随全国碳市场覆盖行业扩大及CCER成交价格上行，碳信用收入将成为独立盈利贡献点，形成乙醇销售+碳信用双收益结构，有效对冲油价波动风险。"
    },
    {
      "title": "央企股东+全球技术领导者双背书，奠定多工厂扩张能力",
      "desc": "首钢集团（央企，粗钢产能约3000万吨/年）控股，提供长期稳定的原料气供给保障及国有资本财务支持，融资成本显著低于民企。LanzaTech（LNZA）持续技术迭代，其C1固碳平台已从乙醇延伸至乙酸、2,3-丁二醇等高附加值化学品，为首鋼朗澤后续产品多元化提供路线图。IPO募资若用于复制Caofeidian模式至其他钢厂（宝钢、鞍钢等央企均有类似废气资源），规模放量潜力显著，属轻资产扩张逻辑（技术已验证，主要复制设备采购与建设）。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "首钢京唐减产直接切断原料气，产量与收入挂钩钢铁周期",
      "desc": "公司100%原料来自首钢京唐钢厂高炉废气，任何导致钢厂减产的因素（环保限产、钢铁行业下行去产能、工厂检修停炉）都将直接等比例削减可发酵气体供给量。首钢集团历史上曾在2015-2016年钢铁寒冬期执行大幅减产，若未来钢铁行业再次景气下行，原料供给的不可控性使公司无法维持正常产能利用率，形成收入端硬性下限风险，且公司无法通过外购原料弥补缺口（外部工业废气无法保证气体组分一致性）。"
    },
    {
      "icon": "⚠️",
      "title": "LanzaTech技术授权协议潜在变动：费率上调或技术支持中断",
      "desc": "公司核心发酵技术菌株、工艺专利及持续的微生物优化迭代均依赖与LanzaTech的专利授权与技术服务协议。LanzaTech（LNZA）2023年借壳上市后持续亏损（年净亏损超5000万美元），现金消耗压力或迫使其调高授权费率以改善营收；此外，若中美技术脱钩压力升级，美国商务部将LanzaTech列入相关出口管制名单，将影响技术升级迭代的持续性。公司在招股书中应披露授权协议到期日及关键条款，授权费与营收的比率是核心关注点。"
    },
    {
      "icon": "⚠️",
      "title": "燃料乙醇出厂价与油价强联动，低油价周期毛利率可能断崖式下跌",
      "desc": "国内燃料乙醇出厂价由国家发改委参照成品油价格挂钩调整，历史价格区间约5,000–7,500元/吨，波动幅度逾50%。在2020年全球油价崩溃（WTI一度负价）期间，国内乙醇出厂价跌至约4,500元/吨，接近甚至低于运营成本（电力+催化剂+维护+固定费用）。即便原料成本为零，在低油价环境下公司无法灵活停产（发酵菌群一旦停止运营需重新培育），固定成本刚性导致现金流为负，此风险在A1招股书中的压力测试场景应予重点关注。"
    }
  ],
