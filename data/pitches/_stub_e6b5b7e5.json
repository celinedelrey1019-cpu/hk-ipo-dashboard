  "thesis": [
    {
      "title": "国产模拟IC进口替代——万亿赛道的结构性机会",
      "desc": "中国模拟IC年需求规模超3000亿元人民币（2025E），TI/ADI/Maxim等美系厂商历史占据60-70%市场份额；中美贸易摩擦背景下华为、比亚迪、宁德时代等国内头部终端厂商加速采购替换，优先绑定国产供应商；头部国产模拟IC设计公司受益于此结构性红利，市占率有望从当前约15%在未来3-5年提升至25-35%"
    },
    {
      "title": "港股半导体IC设计稀缺标的——南向资金配置价值突出",
      "desc": "港股纯正模拟/电源管理IC设计标的极为稀缺，国内主要竞争对手（圣邦股份、纳芯微、芯朋微等）均在A股STAR板上市，南向资金通过港股无法直接参与；若海光芯正成功登陆港股，将填补这一稀缺性配置空白；南向资金对港股半导体板块持续增配，中小盘新股若获机构共识买入可产生显著股价催化效应"
    },
    {
      "title": "新能源汽车与工业电气化驱动模拟IC需求升级",
      "desc": "新能源汽车每辆搭载模拟IC价值量约为传统燃油车的3-5倍，2025年中国新能源渗透率突破50%后持续催化量价升级；工业自动化、储能逆变器、光伏并网等领域亦贡献大量增量需求；车规/工业级客户转换成本高、认证周期长（通常18-24个月），一旦进入供应链体系可提供稳定的收入能见度和毛利率支撑"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "大客户集中度过高导致营收断崖风险",
      "desc": "国内模拟IC行业普遍存在前三大客户营收占比50-70%的客户集中现象；若主要客户（如某大型新能源或消费电子厂商）采购节奏延迟、芯片验证周期拉长或切换至替代供应商，将对当期收入产生断崖式冲击；大型客户（如华为系、比亚迪系）在供应链整合中议价权强势，可能持续压缩产品售价，历史上部分A股模拟IC公司因此出现毛利率连续3-4个季度收窄"
    },
    {
      "icon": "⚠️",
      "title": "成熟制程代工产能依赖与晶圆涨价挤压利润",
      "desc": "国内模拟/电源IC公司普遍采用fabless模式，高度依赖华虹半导体、中芯国际等代工产能（主流制程0.18μm-28nm）；若代工成本上涨10-15%而终端售价传导滞后，将对45-60%的毛利率产生3-5百分点压缩影响；此外若部分工序依赖境外代工（台积电），面临地缘政治管制断供风险，备料及转移产能过渡期可能长达12-18个月"
    }
  ],
