  "thesis": [
    {
      "title": "PCB微钻针全球稀缺龙头",
      "desc": "公司是全球出货量领先的PCB微钻针、铣刀供应商之一，长期与日本Union Tool、OSG等国际厂商正面竞争并持续实现进口替代，在国内PCB钻针市场占有率维持领先地位，客户覆盖深南电路、沪电股份、景旺电子、生益科技等主流PCB制造商"
    },
    {
      "title": "AI服务器/高多层板驱动钻针耗用量上行",
      "desc": "AI算力基建带动的高多层数、高密度互连（HDI）PCB需求快速增长，单块高阶服务器主板所需钻孔数量与精度要求显著高于传统消费电子板，为公司核心钻针业务打开量价齐升的结构性增长空间"
    },
    {
      "title": "硬质合金材料自给+通用刀具第二曲线",
      "desc": "公司自建钨钢棒材等硬质合金原材料产能，实现从原材料到成品刀具的垂直一体化，在当前中国钨资源出口管制背景下具备相对成本与供应稳定性优势；同时拓展通用硬质合金刀具至新能源汽车、航空航天等领域，降低对单一PCB下游周期的依赖"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "下游PCB客户集中度较高",
