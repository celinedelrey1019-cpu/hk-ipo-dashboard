  "thesis": [
    {
      "title": "在线平台商业模式轻资产化——规模效应驱动利润拐点",
      "desc": "在线服务平台边际成本接近零的商业模式特征决定其收入突破临界规模后利润率可快速改善；若公司已积累一定用户基础（MAU/DAU为核心验证点），平台网络效应将构建护城河并支撑货币化率提升；A1文件中需重点验证：近三年营收复合增速是否>25%、用户留存率>60%（月留存）、ARPU值增长趋势及LTV/CAC比值是否>3x"
    },
    {
      "title": "港股互联网板块配置窗口——稀缺性溢价潜力",
      "desc": "港股主板同类别在线服务标的数量有限，若白鴿在線所处细分赛道（待A1文件确认）在港股市场具备稀缺性，将对南向资金和海外机构产生差异化配置吸引力；2026年港股科技/互联网板块整体估值从历史低位修复，新增优质在线服务标的上市窗口期有利；若定价隐含NTM P/S低于三市场中位，存在向上修复空间"
    },
    {
      "title": "AI赋能在线服务效率提升——降本增效催化边际利润",
      "desc": "若公司在客服、内容生成、推荐算法等环节引入大模型能力，运营成本可降低15-30%；用户体验改善带动留存率提升，有助于改善LTV/CAC比值；AI应用落地节点（招股文件中是否有具体AI战略披露）将成为上市后股价催化剂；需A1文件验证：R&D费用率、AI工具具体应用场景及对应量化效率提升数据"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "用户获取成本攀升导致LTV/CAC倒挂",
      "desc": "在线服务平台在增长期普遍面临获客成本（CAC）持续上升风险：若流量成本（字节/腾讯生态竞价广告）年度涨幅>20%而用户ARPU提升滞后，将形成持续烧钱困局；需A1文件核实：营销费用占营收比例是否持续高于35%、自然流量（口碑/病毒传播）占比趋势、付费用户转化率是否出现下滑；若LTV/CAC<2x则商业模式可持续性存疑"
    },
    {
      "icon": "⚠️",
      "title": "监管政策收紧——在线服务合规成本骤升风险",
