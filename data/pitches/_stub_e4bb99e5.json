  "thesis": [
    {
      "title": "SRC平台「Android of AMRs」：向競爭對手收版稅的獨特飛輪",
      "desc": "仙工最核心投資邏輯在於SRC導航調度軟件OEM授權：中小型AMR廠商若缺乏自研激光SLAM，可採購SRC授權嵌入自家機器人，仙工因此從競爭對手每台機器人出貨中收取版稅。SRC授權毛利率估計高達70-80%，遠優於硬件的35-45%，隨OEM客戶規模擴大邊際利潤率自然提升，且SRC生態越大切換成本越高。中國AMR市場400+廠商中，具備成熟自研導航能力的不足10%，SRC的潛在OEM客群龐大，此商業模式形成可防禦的雙邊護城河。"
    },
    {
      "title": "全球化比例高於同業：海外高毛利市場早期卡位",
      "desc": "據行業報道，仙工海外收入佔比達20-30%（遠高於多數中國AMR廠商的5-10%），覆蓋東南亞、中東、歐洲市場。海外客戶通常接受更高定價（歐美同類AMR售價是中國市場1.5-2倍），且更傾向採購包含SRC平台的完整解決方案。早期出海積累的本地認證（CE、UL等）及服務能力構成後進者壁壘。在中美貿易摩擦持續背景下，仙工非軍工背景的定位有助規避制裁風險，東南亞可作中國AMR廠商安全出海橋頭堡。"
    },
    {
      "title": "電商3PL+製造業雙輪驅動，Fleet擴容形成高黏性復購",
      "desc": "仙工客戶覆蓋電商3PL（菜鳥、京東物流、順豐等）和汽車/電子製造廠，雙輪驅動降低單一行業週期風險。製造業AMR具強替換週期（壽命5-8年），已裝機Fleet的擴容與維保形成高黏性復購。隨中國製造業加速向自動化轉型（製造業用工成本2016-2024年翻倍），AMR需求天花板遠未觸及。仙工若憑SRC平台鎖定系統集成商渠道，將進一步放大訂單能見度與長期訂閱性收入。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "SRC大型OEM客戶自研導航棧或轉向開源方案",
      "desc": "若前3大OEM授權客戶（預計貢獻SRC軟件收入50-70%）決定自研激光SLAM導航棧或轉向ROS2等開源方案，將直接侵蝕高毛利SRC授權收入。大客戶規模達一定體量後傾向去依賴供應商（類似安卓廠商自研SoC），中小型AMR廠商若被大型資本收購亦可能整合自有導航能力。SRC授權收入一旦下滑，整體毛利率可能從45%壓縮至接近行業硬件平均的30-35%，對估值構成重大下行壓力。"
    },
    {
      "icon": "⚠️",
      "title": "中國AMR硬件價格戰加劇，應收帳款週轉惡化",
      "desc": "中國400+AMR廠商競爭白熱化，激光SLAM AMR均價2020-2024年已下降約40-50%，預計仍以每年10-20%速度持續下行；若硬件毛利率從35%壓縮至25%以下而SRC授權增長未能補位，公司將陷入收入增長但利潤率惡化困境。同時B2B大客戶通常要求90-150天帳期，若電商3PL客戶資本開支縮減（如某大型電商拆分物流業務），應收帳款週轉天數拉長、壞帳風險上升，可能引發流動性緊張並被迫低價增發融資。"
    }
  ],
