  "thesis": [
    {
      "title": "苹果AI换机潮推动核心精密件量价齐升",
      "desc": "领益智造是苹果iPhone/iPad/Mac钛合金框体、MIM精密件、铝合金CNC结构件的核心Tier 1供应商。苹果Apple Intelligence功能深度整合推动2025-2026年高端机型换机率上升，同时iPhone 17/18系列钛合金用料比例进一步扩大，领益单机供货价值量（ASP）预计提升5-10%，叠加出货量温和增长，2025-2026E营收增速可达10-15%。"
    },
    {
      "title": "热管理材料布局AI算力散热增量赛道",
      "desc": "公司自2020年起深耕石墨导热薄膜、相变导热材料等热管理产品线，客户从消费电子延伸至AI服务器及数据中心散热模组领域。该业务毛利率约25-30%，显著高于传统精密金属件的12-15%，且客户分散度更高（不依赖苹果单一客户）。若AI服务器端出货保持高增速，热管理业务有望在2026年将营收占比从约8%提升至15%以上，驱动整体毛利率企稳回升。"
    },
    {
      "title": "H股上市开启A-H折价收窄交易机会",
      "desc": "领益智造A股（002600.SZ）长期受制于国内制造业估值体系，历史P/E约15-22x，低于蓝思科技、立讯精密等同业。H股上市后将纳入港股通，接触国际机构资金以全球精密制造估值体系重新定价。若H股折价约30-35%在A股招募，后续随公司业绩兑现及港股通资金介入，存在A-H折价从30-35%收窄至15-20%的套利空间，对应股价弹性约15-25%。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "苹果单一客户营收占比逾60%，订单波动直接穿透利润表",
      "desc": "根据公司A股年报披露，苹果系收入长期占领益总营收55-65%。2023年iPhone 15 Pro因MIM钛合金件良率爬坡缓慢，领益单季度营收环比下滑超15%，净利润同期下滑超25%。若苹果2026年机型切换导致精密金属件供应商份额重新分配（蓝思科技、长盈精密均在争夺同类产品份额），或苹果主动推进Tier 2备份供应商策略，领益产能利用率可能从正常水平85%以上跌至65%以下，固定成本摊销将对毛利率形成额外下压。"
    },
    {
      "icon": "⚠️",
      "title": "精密金属件行业系统性产能过剩，毛利率存在进一步压缩至15%以下的风险",
      "desc": "2022-2024年国内精密制造龙头（蓝思科技大幅扩产湖南基地、长盈精密越南产能释放、捷荣技术东南亚布局）导致行业整体产能利用率从2022年峰值约82%降至2024年约70-75%。领益智造毛利率已从2021年约19%持续下滑至2024年约16-17%；若苹果2026年继续要求供应商年降价3-5%、叠加铝/钛等原材料价格周期性上涨，净利率存在跌破4%的风险，对应市值估值支撑力度明显减弱。"
    }
  ],
