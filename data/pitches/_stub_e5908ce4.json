  "thesis": [
    {
      "title": "百年品牌护城河，信任资产难以复制",
      "desc": "同仁堂创立于1669年，拥有超过355年品牌积淀，在中医药领域消费者信任度远超新兴竞争者。医养业务依托母公司品牌授权，可在获客成本极低的前提下快速扩张门诊网络；品牌壁垒叠加口碑效应，使其在同质化竞争的中医服务市场中具备显著的定价权和客户粘性。"
    },
    {
      "title": "政策红利与人口结构双重驱动",
      "desc": "国家十四五规划明确将中医药振兴列为战略重点，医保扩大中医诊疗报销范围提升可及性；中国65岁以上老龄人口已超2.1亿，对中医调理、慢病管理及健康管理的需求持续放量，公司战略方向与人口结构变化高度契合，需求端具备长期确定性。"
    },
    {
      "title": "从产品到服务的商业模式升级，享受估值重塑",
      "desc": "传统同仁堂以中成药产品为核心，医养板块转型为医疗服务提供者，通过门诊、健康管理、养老康复等高粘性服务实现客户复购率提升与ARPU扩大。服务型商业模式相较产品型具有更高估值倍数预期，分拆港股独立上市有望通过板块重新定价释放估值溢价。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "执业中医师严重短缺制约门店扩张速度",
      "desc": "全国执业中医师总量不足60万且向头部公立医院高度集中，公司门诊网络扩张直接受制于高水平中医师招募瓶颈。若依赖母公司调拨医师资源则存在关联方利益冲突；若市场化外部招募，人工成本将大幅攀升，压缩新开门店单店利润率至盈亏平衡边缘，规模化扩张的边际成本将远高于固生堂等连锁对标。"
    },
    {
      "icon": "⚠️",
      "title": "高度依赖母公司关联交易，定价公允性存疑",
      "desc": "作为同仁堂集团分拆实体，公司核心药材采购、品牌授权使用费、IT系统及部分行政服务均依赖同仁堂股份（600085.SH）及同仁堂国际（8138.HK）提供，关联交易规模及转移定价合理性是核心财务风险。若母公司上调品牌授权费或调整采购定价，将直接侵蚀毛利率；且关联交易结构在港交所上市审查中属高风险披露项，可能导致IPO进程延期或估值折价。"
    }
  ],
