  "thesis": [
    {
      "title": "Delta机器人国产替代加速渗透",
      "desc": "中国工业机器人市场长期被ABB、发那科、安川、库卡四大家族主导，高速并联Delta机器人领域中国企业近年凭借性价比优势和本地化服务响应速度快速渗透，进口替代空间仍有约40-50%的市场份额可争夺。翼菲科技作为国内Delta机器人细分龙头，深度绑定食品饮料、医药包装等高频采购客户，具备先发优势与客户粘性"
    },
    {
      "title": "AI视觉融合推动整线集成高毛利方案放量",
      "desc": "随着机器视觉、AI调度算法与Delta机器人深度融合，翼菲科技产品已从单纯硬件工具升级为具备视觉引导的智能分拣整线系统。整线集成方案毛利率通常高于标准设备约10-15个百分点，软件与服务收入占比提升将有效对冲硬件价格战对毛利率的侵蚀，并提升收入可见性"
    },
    {
      "title": "医药与新能源双轮驱动客户结构多元化",
      "desc": "核心赛道医药自动化受GMP合规升级驱动，资本开支意愿持续强劲；新能源电池模组组装、光伏组件分选等新场景对高速并联机器人需求快速涌现，成为新增量。客户结构持续从食品饮料单一依赖向医药+新能源+3C三极分散演进，有望降低大客户风险敞口并平滑行业周期波动"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "大客户集中度风险：单一客户验收延迟引发收入剧烈波动",
      "desc": "前五大客户历史上贡献营收超60%，若头部食品饮料龙头客户将资本开支推迟一个季度，翼菲科技当期收入可能出现15-25%缺口（历史曾因大客户验收延迟导致单年业绩大幅低于预期）。此类项目制收入确认依赖客户验收节奏，难以平滑，港股投资者对此类业绩波动容忍度低"
    },
    {
      "icon": "⚠️",
      "title": "Delta机器人赛道价格战加剧：毛利率持续下行压力",
      "desc": "2022年以来埃斯顿、拓斯达、华数机器人等上市竞争对手通过规模效应大幅降价，Delta机器人市场均价年均下滑约15-25%。若翼菲科技无法维持速度、精度与稳定性的技术差异化壁垒，毛利率存在从40%+持续滑落至30%以下的风险，同类企业（如拓斯达）毛利率下行趋势已部分印证此路径"
    }
  ],
