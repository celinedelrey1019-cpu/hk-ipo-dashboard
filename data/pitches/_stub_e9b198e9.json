  "thesis": [
    {
      "title": "中国跻身全球最大鱼子酱产国，头部企业享受定价权与国际品牌溢价",
      "desc": "中国已超越伊朗、法国成为全球最大鱼子酱生产国，年产量超过200吨（占全球约60-70%），主要出口欧盟、日本、美国等高端市场。具备规模化养殖与品控能力的头部企业已建立国际品牌知名度及欧盟HACCP/BRC等食品安全认证体系，在全球高端餐饮渠道积累稳定客群。相比伊朗/俄罗斯竞争对手，中国头部企业受地缘政治影响更小，供应链稳定性更高，西方市场渗透率持续提升，定价权逐步强化。"
    },
    {
      "title": "鱘鱼全产业链多元化产品组合，摊薄单一caviar风险并提升资产综合回报",
      "desc": "鱘鱼整体具极高商业价值：鱼子酱为核心高毛利品类，鱼肉可作高端食材（售价高于普通淡水鱼5-10倍），鱼皮可制作皮革制品，鱼骨胶原蛋白在美妆/医疗领域有应用前景。多元产品矩阵允许企业在等待caviar成熟期（7-15年）通过鱼肉、幼鱼销售产生现金流，平滑长周期养殖风险；产品线延伸至护肤品、保健品等高附加值领域可进一步提升整体EBITDA Margin，降低对单一caviar价格周期的敏感性。"
    },
    {
      "title": "国内高端消费崛起，内销市场从边际起步进入快速成长期",
      "desc": "鱼子酱在中国消费长期依赖出口，但随高净值人群扩大、西餐文化普及及直播/新零售渠道兴起，国内消费量近年以20-30% CAGR增长。头部企业开拓国内高端酒店、Michelin餐厅供货及礼品装市场，内销毛利率通常高于出口（中间商环节减少）。若公司成功实现内外销均衡，盈利质量有望显著提升，同时可对冲人民币升值对出口利润的侵蚀，收入结构更加健康。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "生物资产集中损失风险：疫病或环境灾害可致多年投资瞬间归零",
      "desc": "鱘鱼养殖周期长达7-15年，成熟鱼群代表公司数年资本积累；一旦发生大规模鱼病（弹状病毒、溃疡病）、上游水体污染（工业排放）或极端气候事件（持续高温导致水体缺氧），大量生物资产可能数天内损失殆尽。历史参照：獐子岛（002069.SZ）2014年及2019年因气候异常损失虾夷扇贝，市值数度腰斩。HKFRS下生物资产按公允价值计量，损失发生时当期利润将承受灾难性冲击，且此类风险无法完全通过保险覆盖。"
    },
    {
      "icon": "⚠️",
      "title": "出口单一市场依赖与食品安全监管风险：欧盟/日本标准趋严可快速中断营收",
      "desc": "高端鱼子酱依赖欧盟、日本、美国市场，上述市场对重金属含量（汞、镉）、抗生素残留、防腐剂标准极为严苛。若欧盟修订Regulation (EC) No 853/2004或日本厚生劳动省收紧进口标准，公司可能面临产品被暂停进口的尾部风险。同时出口收入高度集中于少数大客户（高端食材分销商、酒店集团），前五大客户集中度为A1关键验证点；若核心客户因采购策略调整削减订单，将造成收入骤降且替代周期漫长。"
    }
  ],
