  "thesis": [
    {
      "title": "血浆采集站系稀缺许可证资产，供给刚性支撑长期护城河",
      "desc": "NMPA对血浆站实行总量管控，省级卫生主管部门联审，新建审批周期通常3-5年且成功率极低；现有采集站数量直接决定企业血浆原料上限，无法通过资本投入快速扩产。若公司拥有多个省级血浆采集站许可证，其稀缺性构成不可复制的进入壁垒，竞争对手无法短期内通过新建产能颠覆市场地位，确保中长期收入可见度。"
    },
    {
      "title": "人血白蛋白及IVIG刚性需求，医保降价压力相对可控",
      "desc": "人血白蛋白用于ICU重症、腹水/肝硬化、肿瘤支持治疗等不可替代临床场景，临床替代品匮乏；IVIG用于自身免疫性疾病及神经科领域需求持续扩大；两大核心品种合计占血液制品行业收入超65%。血液制品未纳入常规国家集采（系人体血液来源），医保谈判对血制品价格下行约束相对温和，毛利率压缩幅度显著小于化学药。"
    },
    {
      "title": "国内人均采浆量远低于国际水平，进口替代空间持续释放",
      "desc": "中国每千人口年采浆量约6-7升，远低于美国约35升；中国临床人血白蛋白约60-70%依赖进口，供应链安全压力推动政策鼓励国内扩产；「浆站倍增计划」方向明确，拥有规模浆站的本土企业将直接受益进口替代和供给增量。Grifols财务危机削弱其全球扩张意愿，为中国本土血浆企业提供难得的市场窗口。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "单浆站采浆量受人口结构约束，献浆者流失率影响有效产量",
      "desc": "血浆采集站的献浆者来源依赖周边农村/城镇固定人群，单站年采浆量通常30-50吨，且受献浆者健康状况、季节性、流失率影响波动明显；若浆站集中于特定地区，人口红利有限、献浆者年龄老化可能致采浆量增速低于同业；若病毒检测不合格率偏高（乙肝/梅毒阳性比例过高），有效采浆量折损严重，直接影响产品放行量与收入。"
    },
    {
      "icon": "⚠️",
      "title": "核心品种省级挂网价存在阶段性下调压力，产品结构单一放大风险",
      "desc": "省级药品挂网价格为血液制品出厂价的核心约束，2022-2024年部分省份对IVIG挂网价已进行阶段性下调（幅度5-15%）；若公司产品结构中凝血因子/特异性免疫球蛋白等高附加值品种占比较低，单位收益弱于天坛/华兰，估值溢价难以维持；若白蛋白与IVIG合计收入占比超80%且均面临价格压制，综合毛利率存在持续下行风险。"
    }
  ],
