  "thesis": [
    {
      "title": "美国出口管制「强制替代」，多核AI芯片需求爆发式增长",
      "desc": "美国持续加码对华AI芯片制裁（A100/H100/H800/B系列全面禁运），倒逼中国云厂商（阿里、百度、腾讯、字节）及AI独角兽转向国产算力。MANYCORE TECH多核并行架构与DeepSeek等国产大模型MoE稀疏注意力计算范式天然契合，在训练与推理双场景均可替代进口GPU，具备直接承接替代需求的技术与产品基础，供给稀缺性支撑溢价估值。"
    },
    {
      "title": "政府采购与央企云定向导流，订单可见度高",
      "desc": "工信部「算力普惠」专项及新型基础设施专项资金明确要求国产芯片采购比例，国央企云服务商（天翼云、移动云、华为云）国产算力采购占比目标已升至50-60%以上。MANYCORE TECH若已进入政府白名单并通过测评，则政府及国央企客户订单形成收入底部托底，大幅降低收入波动风险，改善企业现金流稳定性。"
    },
    {
      "title": "从芯片向「芯片+工具链+系统」平台延伸，提升价值链附加值",
      "desc": "参照地平线、黑芝麻智能等同类芯片厂商发展路径，多核AI芯片企业在形成规模出货后，将软件工具链（编译器、推理框架、量化工具）及整机/集群系统解决方案纳入收入结构，单客户ARPU与粘性大幅提升；平台型收入毛利率可由纯芯片的40-50%提升至60%+，并逐步引入订阅式软件维护收入，改善长期盈利质量。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "先进制程依赖单一代工厂，配额削减即触发收入断层",
      "desc": "国内多核AI芯片设计公司当前主流产品多采用台积电7nm/5nm工艺或中芯国际N+2工艺流片；若美国进一步收紧对台技术出口或台积电对中国客户配额缩减，MANYCORE TECH将面临无法量产或产能骤降风险。若A1招股书显示其制程集中于单一代工厂且比例超80%，该风险将直接构成业绩断层威胁，需重点核查供应链多元化布局情况。"
    },
    {
      "icon": "⚠️",
      "title": "前五大客户收入占比过高，单笔大单延迟即冲击全年业绩",
      "desc": "国产AI芯片初期商业化阶段，客户通常高度集中于头部云厂商（阿里云、百度智能云、腾讯云等），前三大客户贡献收入比例普遍超60%（参照黑芝麻、爱芯元智等同期公司披露数据）。若主力客户因资本开支计划调整或转向华为昇腾/寒武纪替代产品而推迟采购，单季度收入可能骤降30-50%，直接引发大幅亏损扩大并触发股价大幅回调风险。"
    }
  ],
