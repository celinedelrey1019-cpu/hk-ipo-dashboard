  "thesis": [
    {
      "title": "AI終端換機週期的核心製造受益者",
      "desc": "華勤技術服務小米、vivo、OPPO等主流品牌，AI手機滲透率從2024年不足15%預計到2026年超40%。AI終端硬件規格升級（DRAM容量提升、散熱模組升級、NPU整合）推高單機BOM成本，直接帶動ODM ASP提升5-15%。華勤作為全球前三ODM，可優先獲得AI手機新機型設計製造訂單，收入彈性領先中小ODM廠。"
    },
    {
      "title": "新品類擴張改善盈利結構",
      "desc": "公司積極拓展汽車電子（車載娛樂系統、ADAS控制器）、AIoT（智能音箱、AR/VR設備）及儲能模組等高毛利率品類。新品類毛利率估計8-12%，顯著高於手機ODM的5-7%，隨新品類收入佔比提升至20%+，整體毛利率有望改善至7-9%，驅動淨利率回升至3%+，打破傳統ODM估值天花板。"
    },
    {
      "title": "規模壁壘與供應鏈整合能力構築護城河",
      "desc": "年出貨量達數億台的超大規模使華勤在芯片、屏幕、DRAM等核心元器件採購中享有顯著折扣，部件成本較中小型ODM低估計5-10%。公司已建立覆蓋全供應鏈的垂直整合能力，客戶切換成本高，近五年主要客戶流失率低於5%，確保收入基盤穩定，支撐長期現金流可預測性。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "核心客戶訂單流失：品牌商自研ODM能力威脅",
      "desc": "前五大客戶收入佔比超60%，小米等頭部品牌持續加強自研設計能力（如澎湃芯片、自研基帶），部分機型有內化ODM趨勢。若單一大客戶將20-30%訂單轉移至自研或競爭對手（闻泰、龙旗），對華勤年度利潤影響可達10-20%；且ODM重新競標週期一般長達12-18個月，業績修復緩慢。"
    },
    {
      "icon": "⚠️",
      "title": "ODM三強定價戰持續，毛利率存在跌破臨界值風險",
      "desc": "中國ODM三強（华勤、闻泰、龙旗）在同一品牌客戶競標中博弈，行業毛利率已從2019年的8-10%壓縮至當前6-7%水平。若全球智能手機出貨量復蘇不及預期（IDC預測2025年增速放緩至3-5%），三強競爭烈度加劇，單機利潤率進一步攤薄，淨利率或跌破2%盈虧邊緣值，拖累ROE惡化並引發估值重估。"
    }
  ],
