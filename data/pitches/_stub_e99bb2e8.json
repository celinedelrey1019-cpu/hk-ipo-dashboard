  "thesis": [
    {
      "title": "OLED国产替代进入加速期，DDIC本土化是核心环节",
      "desc": "中国手机品牌（小米、OPPO、vivo、荣耀）在元器件国产化压力下持续提升国内DDIC供应商份额，从依赖Magnachip、Synaptics向本土供应商切换；BOE、维信诺、天马等国内OLED面板厂扩产所配套的DDIC需求天然向本土供应商倾斜，雲英谷作为专注OLED DDIC的纯正标的受益最直接"
    },
    {
      "title": "LTPO技术切换打开高端化升级空间",
      "desc": "智能手机从固定60Hz屏幕向1-120Hz可变刷新率（LTPO）升级，对应DDIC芯片复杂度与ASP显著提升；AI手机将常亮显示（AOD）与动态内容推送作为核心体验，高端LTPO DDIC需求持续增长；若雲英谷已完成LTPO量产交付，则其产品结构向高毛利高端品迁移，毛利率及ARPU有望持续提升"
    },
    {
      "title": "Fabless模式下规模效应驱动盈利杠杆",
      "desc": "芯片设计公司固定成本主要集中在研发与IP授权，一旦流片完成进入量产阶段，增量收入几乎全部转化为毛利增量；国内OLED出货量从2023年约6亿颗/年向2026年9亿颗/年增长，量价齐升下雲英谷的营业杠杆效应将显著体现，亏损期企业可能在规模跨越后快速实现盈亏平衡"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "客户集中度高：三星/苹果系外客户结构脆弱",
      "desc": "OLED DDIC下游客户高度集中于少数中国手机OEM品牌，行业参考（新相微688593.SH招股书）显示前五大客户贡献约65-75%收入；任一大客户启动供应商内部化（自研DDIC团队）、更换芯片供应商或削减旗舰机备货，均将直接导致季度出货量大幅波动，历史上类似事件已在国内IC设计公司中多次出现"
    },
    {
      "icon": "⚠️",
      "title": "制程节点依赖：先进节点产能争夺加剧导致量产窗口收窄",
      "desc": "OLED AMOLED DDIC需要28nm及以下制程节点（通常在台积电、联华电子或中芯国际先进产线流片），若遭遇产能紧张或美国出口管制扩大至相关制程设备，将直接影响新品流片周期和量产爬坡速度；同时，若技术路线从现有节点向更先进制程迁移时出现良率问题，将造成大规模库存损失和客户交付延误"
    }
  ],
