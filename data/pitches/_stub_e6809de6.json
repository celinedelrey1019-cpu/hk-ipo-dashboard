  "thesis": [
    {
      "title": "AI调度软件构建差异化护城河，跳出硬件价格战",
      "desc": "纯硬件储能系统已高度同质化，BESS系统价格持续下探。思格新能以AI能量管理系统（EMS）为核心，通过峰谷价差预测、需量控制、负荷优化算法提升用户IRR，有望在集成商红海中实现软件+服务差异化定价，并逐步演化为订阅制SaaS收入，提升毛利率天花板与收入粘性"
    },
    {
      "title": "工商业储能赛道高景气，90亿收入体量印证规模领先地位",
      "desc": "中国工商业储能市场2023-2025年年均增速超60%，峰谷价差扩大政策（多省工商业用电峰谷差>0.7元/kWh）及需量电费改革持续释放需求。公司2025年约90亿RMB营收体量在C&I储能领域居头部梯队，规模效应带来供应链议价力与项目获取优势"
    },
    {
      "title": "港股稀缺AI储能标的，具备主题资金虹吸效应",
      "desc": "港股市场几乎无纯正AI+工商业储能上市标的，思格新能若定价合理，将成为新能源与AI主题资金的稀缺配置标的；叠加2026年港股IPO市场持续回暖、机构参与度提升，上市初期有望获得显著的流动性溢价"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "储能系统价格战致毛利率持续崩塌",
      "desc": "中国LFP储能系统价格已从2022年约1.5元/Wh跌至2025年约0.4-0.5元/Wh，跌幅超60%，且仍未见底。思格新能作为系统集成商，上游被宁德时代/亿纬锂能等电池巨头压制采购价，下游工业/商业客户压价竞争激烈，毛利率若跌破12%则AI软件溢价难以弥补，净利润将受严重侵蚀"
    },
    {
      "icon": "⚠️",
      "title": "客户集中度高叠加应收账款回款风险",
      "desc": "工商业储能项目通常依赖少数头部工业园区运营商或商业地产客户（前五大客户贡献50%+收入为行业惯例），客户议价强且合同续约不稳定。EPC项目验收后回款周期达90-180天，若2025年约90亿RMB收入中应收账款比例超30%，则逾26亿RMB应收款面临坏账风险，一旦大客户资金链承压将直接冲击公司现金流"
    }
  ],
