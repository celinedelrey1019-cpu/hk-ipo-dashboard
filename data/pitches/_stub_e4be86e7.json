  "thesis": [
    {
      "title": "人形機器人關節需求爆發，諧波減速器進入量價齊升週期",
      "desc": "人形機器人每台需使用12-40個諧波減速器（腕關節、肘關節、踝關節等），以2030年中國人形機器人累計出貨目標百萬台以上計算，年新增諧波需求超千萬套；來福諧波若完成對特斯拉Optimus、宇樹科技、傅里葉等頭部整機廠的技術驗證並實現批量供貨，訂單規模有望進入指數級增長通道；諧波減速器技術壁壘（重複定位精度±1弧秒、傳動效率85%+）確保切入供應鏈後客戶粘性強、遷移成本高"
    },
    {
      "title": "日系供應商依賴加速向國產替代轉移，本土份額提升空間大",
      "desc": "全球諧波減速器市場長期由日本Harmonic Drive Systems（HD）及Nabtesco主導，合計市佔率超60%；中美科技博弈背景下，中國機器人整機廠積極推進零部件供應鏈本土化，政策導向採購及供應鏈安全溢價為本土供應商提供定價保護；截至2024年，中國國內諧波減速器本土化率仍低於50%，具備規模量產能力的國產廠商受益進口替代紅利，市場份額提升空間顯著"
    },
    {
      "title": "工業與協作機器人同步增長，下游多元化提供基本盤穩定性",
      "desc": "除人形機器人外，傳統工業機械臂（焊接、搬運、噴塗）及協作機器人（汽車柔性產線、醫療輔助）亦大量採用諧波減速器；CNC機床高精度軸系及半導體設備晶圓傳輸機構亦需諧波驅動，下游場景多元化可平衡人形機器人落地進度不及預期帶來的訂單波動風險；工業自動化下游景氣度維持高位，為公司提供穩定基本盤收入"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "绿的谐波規模壁壘形成強競爭壓制，跟隨者面臨持續降價壓力",
      "desc": "绿的谐波（688017.SH）在國內諧波減速器市場佔有率超60%，已形成規模效應與品牌護城河；下游整機廠傾向對來福諧波等追隨者採用壓價策略以鞏固議價能力，行業ASP每年降幅預計5-10%；若來福諧波在技術規格（重複定位精度、壽命週期、空心軸輕量化設計）上與绿的谐波存在差距，規模化僅能以價換量，毛利率可能長期低於行業龍頭20-25個百分點，侵蝕盈利成長空間"
    },
    {
      "icon": "⚠️",
      "title": "頭部整機廠加速自研關節模組，外採規模可能縮減",
      "desc": "汇川技术（300591.SZ）、埃斯顿（002747.SZ）等頭部自動化公司已披露研發自製關節模組計劃，深度垂直整合以降低零部件成本；人形機器人主機廠（宇樹、智元等）亦有戰略意圖內製核心部件；若來福諧波主要收入集中於2-3家大客戶（行業客戶集中度通常達40-60%），一旦頭部客戶轉向自研或切換供應商，將面臨收入驟降風險；人形機器人賽道2025年實際出貨量遠低於年初各廠公開目標，訂單可見度偏低"
    }
  ],
