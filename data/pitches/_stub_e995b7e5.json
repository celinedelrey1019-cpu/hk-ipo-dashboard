  "thesis": [
    {
      "title": "科学sCMOS国产唯一，进口替代空间超30亿RMB",
      "desc": "科学级sCMOS图像传感器此前由Teledyne Photometrics/Andor（英国）、Hamamatsu（日本）三家外资垄断，均面临出口管制与交货周期风险。長光辰芯依托中科院长春光机所工艺积累，成为国内唯一实现BSI sCMOS批量供货的企业，客户锁定国家重点实验室、顶级医学院校及生命科学仪器商，国产替代对象清晰，存量进口市场替代空间保守估算超30亿RMB/年"
    },
    {
      "title": "生命科学显微镜+工业机器视觉双轮驱动，下游需求刚性扩张",
      "desc": "上游共聚焦/超分辨率/荧光显微镜市场年增速约12-15%，带动高性能传感器同步放量；AI视觉算法渗透工业检测推动机器视觉对高帧率低噪声传感器需求升级。公司多个产品线（sCMOS-4040、sCMOS-2020系列）已通过大型生命科学仪器商认证，一旦进入客户BOM清单，替换成本高形成强粘性收入护城河"
    },
    {
      "title": "港股稀缺性溢价，科学影像赛道在港无直接竞品",
      "desc": "目前港股无任何纯正科学影像传感器标的，SmartSens（2579.HK）专注安防/车载CMOS，产品定位与客户结构差异显著。長光辰芯若成功挂牌将填补港股稀缺性空白，有望成为全球生命科学/精密仪器主题基金在港唯一可配置的中国科学成像代理标的；叠加同类A股标的（长光华芯688048）高溢价参照，港股稀缺性溢价想象空间可观"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "科研客户集中度高，前五大客户收入占比估计超65%",
      "desc": "科学级传感器终端市场结构高度集中：国家重点实验室、985高校及头部生命科学仪器商构成主要客户群，单一大客户（如某国家级物理实验室或顶级科研仪器OEM）的采购计划延迟或预算削减将直接冲击当期收入。国家科研经费五年规划切换窗口（2026年正值十四五末期）存在采购节奏波动风险；类比长光华芯（688048.SH）2022年曾因科研拨款延迟导致营收增速大幅不及预期的先例"
    },
    {
      "icon": "⚠️",
      "title": "BSI sCMOS先进工艺依赖境外晶圆代工，供应链断供风险突出",
      "desc": "公司为Fabless/Fab-Lite模式，背照式sCMOS核心工艺需特殊深耗尽外延及背面减薄后道工艺，目前能满足要求的代工合作方极为有限（主要依赖台积电特殊工艺节点或日本代工商）。在美国出口管制范围持续扩大的背景下，若核心晶圆代工合作受限，公司将面临产品迭代停滞、良率优化受阻的实质性风险；国内替代代工方（中芯国际、华虹）在后照式传感器专用工艺上与国际水平仍有约一代以上差距，短期无法完全替代"
    }
  ],
