  "thesis": [
    {
      "title": "干湿法双平台差异化壁垒",
      "desc": "星源材质同时具备干法和湿法（含涂覆）隔膜量产能力，是国内少数双平台商业化供应商之一。干法主攻储能与LFP体系，湿法覆盖高能量密度三元路线，能满足宁德时代、比亚迪、亿纬锂能等头部客户的多元化需求。双平台策略有效对冲单一技术路线被替代的风险，并在固态电池大规模量产延迟的背景下延长液态隔膜的市场窗口期。"
    },
    {
      "title": "海外布局打开第二成长曲线",
      "desc": "公司已在欧洲建设本地化隔膜产能，直接对接欧洲电池供应链客户。随欧盟《电池法》对本地化生产的强制要求趋严，海外产能将享受更高的毛利溢价，有效对冲国内价格战压力。2023-2024年公司海外出货占比持续提升，是区别于纯国内竞争者的核心差异点，为未来毛利率修复提供路径。"
    },
    {
      "title": "H股折让提供相对估值保护",
      "desc": "历史上A+H双上市结构中，H股较A股折让中位数约20%（材料/能源行业）。若H股以此结构定价，港股投资者实际获得的估值入场价低于A股市场同类资产。当A/H溢价收窄时——包括互联互通机制活跃化或南向资金入场——H股存在均值回归动力，是独立于基本面改善之外的催化剂。"
    }
  ],
  "keyRisks": [
    {
      "icon": "⚠️",
      "title": "隔膜单价持续下跌侵蚀盈利能力",
      "desc": "国内湿法隔膜产能利用率从2021年峰值约90%下滑至2023年约60%以下，头部扩产与中小产能同步释放加剧供给过剩。A1文件显示公司隔膜单位售价2021-2023年累计降幅超35%，若行业价格战延续至2025-2026年而出货量增长无法抵消，公司毛利率可能进一步从20%区间跌破盈亏平衡线，直接威胁维持净利润为正的前提假设。"
    },
    {
      "icon": "⚠️",
      "title": "核心客户集中与账期恶化双重挤压",
      "desc": "公司前三大客户（宁德时代、比亚迪及另一主要客户）合计收入占比超50%，对核心客户议价能力持续弱化。2023年应收账款周转天数较2021年延长约20-30天，下游电池厂账期管理趋严加剧运营资金压力。若宁德时代自研隔膜进展超预期（其已有相关专利布局），或头部客户进一步要求年度降价，将直接冲击公司核心订单量及单价。"
    }
  ],
